                      "bit_width": 1,
                      "description": "Control signal Register for 'ap_ready'.",
                      "access": "read-only"
                    },
                    "RESERVED_1": {
                      "bit_offset": 4,
                      "bit_width": 3,
                      "description": "Reserved.  0s on read.",
                      "access": "read-only"
                    },
                    "AUTO_RESTART": {
                      "bit_offset": 7,
                      "bit_width": 1,
                      "description": "Control signal Register for 'auto_restart'.",
