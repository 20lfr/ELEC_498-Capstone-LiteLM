                  "fields": {
                    "CHAN0_INT_EN": {
                      "bit_offset": 0,
                      "bit_width": 1,
                      "description": "Enable Channel 0 (ap_done) Interrupt.  0 = Disabled, 1 = Enabled.",
                      "access": "read-write"
                    },
                    "CHAN1_INT_EN": {
                      "bit_offset": 1,
                      "bit_width": 1,
                      "description": "Enable Channel 1 (ap_ready) Interrupt.  0 = Disabled, 1 = Enabled.",
