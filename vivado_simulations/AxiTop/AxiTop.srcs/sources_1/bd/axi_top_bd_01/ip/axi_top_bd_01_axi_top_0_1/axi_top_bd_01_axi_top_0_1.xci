                "GIER": {
                  "address_offset": "4",
                  "size": 32,
                  "display_name": "GIER",
                  "description": "Global Interrupt Enable Register",
                  "access": "read-write",
                  "reset_value": "0",
                  "fields": {
                    "Enable": {
                      "bit_offset": 0,
                      "bit_width": 1,
                      "description": "Master enable for the device interrupt output to the system interrupt controller: 0 = Disabled, 1 = Enabled",
                      "access": "read-write"
                    },
                    "RESERVED": {
                      "bit_offset": 1,
                      "bit_width": 31,
                      "description": "Reserved.  0s on read.",
